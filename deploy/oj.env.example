# ThinkCode OJ production environment (variables read by dmoj/local_settings.docker.py.example).
# Not kept on the server: CI writes it from the GitHub secret PRODUCTION_ENV and passes it as DEPLOY_ENV_FILE
# (see .github/workflows/cd.yml and docker-compose.production.yml). Update that secret, not a file on disk.
# Required (no default):
DJANGO_SECRET_KEY=REPLACE_ME
DB_NAME=dmoj
DB_USER=dmoj
DB_PASSWORD=REPLACE_ME
# Optional with defaults in local_settings: DB_HOST=127.0.0.1, DB_PORT=3306
DJANGO_DEBUG=false
ALLOWED_HOSTS=oj.thinkcode.vn
CSRF_TRUSTED_ORIGINS=https://oj.thinkcode.vn
SITE_FULL_URL=https://oj.thinkcode.vn
SITE_NAME=
SITE_LONG_NAME=
SITE_ADMIN_EMAIL=
DMOJ_CANONICAL=
REDIS_URL=redis://127.0.0.1:6379
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
STATIC_ROOT=
MEDIA_ROOT=
DMOJ_PROBLEM_DATA_ROOT=
PROBLEM_AUTHORING_ENABLED=
PROBLEM_AUTHORING_ROOT=
BRIDGED_JUDGE_HOST=
BRIDGED_JUDGE_PORT=9999
BRIDGED_DJANGO_HOST=
BRIDGED_DJANGO_PORT=9998
BRIDGED_DJANGO_CONNECT_HOST=
BRIDGED_DJANGO_CONNECT_PORT=
BRIDGED_R2_PROBLEMS=
WSEVENT_POST_HOST=
WSEVENT_POST_PORT=15101
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Media on R2 (required when USE_R2_MEDIA is on)
USE_R2_MEDIA=
R2_ENDPOINT_URL=
R2_MEDIA_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_CUSTOM_DOMAIN=
R2_MEDIA_PRIVATE=
